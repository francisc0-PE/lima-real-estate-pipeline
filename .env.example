# ==========================================
# Configuracion de Entorno - Pipeline B2B
# ==========================================

ENV_NAME=produccion
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=ERROR

# --- APIS y Red ---
# Proveedor de busqueda (ej. Serper.dev)
SERPER_API_KEY=tu_api_key_aqui
SERPER_RATE_LIMIT_RPS=2.0

# Pool de Proxies (formato: http://user:pass@host:port)
PROXY_LIST=
PROXY_STRATEGY=round_robin

# --- Bases de Datos y Caché ---
CACHE_ENABLED=true
CACHE_BACKEND=sqlite

# Conexion PostgreSQL (para historico y ventas en prod)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pipeline_inmobiliario
PG_USER=postgres
PG_PASSWORD=tu_password_aqui

# --- Parametros Comerciales ---
META_LIMITE_PROSPECTOS=10
EXCLUSIVIDAD_VENTANA_DIAS=30
